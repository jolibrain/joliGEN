FROM nvidia/cuda:12.6.2-devel-ubuntu22.04 AS joligen_build
LABEL description="Generative AI Toolset with GANs and Diffusion for Real-World Applications"
LABEL maintainer="contact@jolibrain.com"
WORKDIR /app
COPY requirements.txt .
COPY docker/install-dependencies.sh docker/install-dependencies.sh
RUN bash docker/install-dependencies.sh
ENV TORCH_HOME=/app/.cache/torch
COPY . /app
ARG JOLIGEN_VERSION=development
ARG JOLIGEN_COMMIT=unknown
ENV JOLIGEN_VERSION=$JOLIGEN_VERSION JOLIGEN_COMMIT=$JOLIGEN_COMMIT
LABEL org.opencontainers.image.version=$JOLIGEN_VERSION
LABEL org.opencontainers.image.revision=$JOLIGEN_COMMIT

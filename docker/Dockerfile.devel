FROM nvidia/cuda:12.6.2-devel-ubuntu22.04 AS joligen_build
LABEL maintainer="contact@jolibrain.com"
WORKDIR /home/jenkins/app
COPY requirements.txt .
COPY docker/install-dependencies.sh docker/install-dependencies.sh
RUN bash docker/install-dependencies.sh
RUN addgroup --gid 127 jenkins && adduser jenkins --uid 119 --gid 127 --system
COPY --chown=jenkins:jenkins . /home/jenkins/app
RUN mkdir -p /home/jenkins/app/.cache/torch && chown -R jenkins:jenkins /home/jenkins
ENV TORCH_HOME=/home/jenkins/app/.cache/torch
USER jenkins
